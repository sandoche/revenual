# Copy to .env; generate SESSION_SECRET using the README command.
NODE_ENV=development
PORT=3000
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/revenual
# Required only with NODE_ENV=production:
MONGODB_URI=
SESSION_SECRET=
HOST_APP=http://localhost:3000
HOST_LANDING_PAGE=http://localhost:3000

# Optional Google Play: absolute path or path relative to the project root.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional beta gate; credentials required only when TRUE.
BASIC_AUTH_PRIVATE_BETA=FALSE
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Optional Stripe: keys and prices must come from the SAME sandbox/account.
STRIPE_ENV_PROD=FALSE
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=
STRIPE_PRICE_MAKER_EUR=
STRIPE_PRICE_MAKER_USD=
STRIPE_PRICE_STARTUP_EUR=
STRIPE_PRICE_STARTUP_USD=
STRIPE_PRICE_ENTERPRISE_EUR=
STRIPE_PRICE_ENTERPRISE_USD=

# Optional Mailjet: API key, secret key, and verified sender.
MAILJET_USER=
MAILJET_PASSWORD=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Revenual

# Optional error reporting; blank disables it.
SENTRY_DSN=
