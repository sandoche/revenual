<div class="subscription__plan card card__container subscription__plan-onboarding">
	<h3 class="subscription__title subscription__title--{{ plan.planName }}">{{ plan.title }}</h3>
	<p class="subscription__feature">
		<strong>
			{% if plan.max == 999999999999999 %}
				+2000
			{% else %}
				{{ plan.min }}
				to
				{{ plan.max }}
			{% endif %}
		</strong>
		{{ __('subscription.products_sold') }}<br>{{ __('subscription.products_sold_2') }}</p>
	<p class="subscription__price">
		{% if plan.max == 999999999999999 %}
			<span class="subscription__currency">{{ plan.currency }}
				10</span>
			<br>
			<span class="subscription__meta">per 1,000 app sales each month</span>
		{% else %}
			<span class="subscription__currency">{{ plan.currency }}</span>
			<span class="subscription__price-value">{{ plan.price | number_format(2) }}</span>
			<span class="subscription__time">/ month</span>
		{% endif %}
		<span class="subscription__meta">{{ __('subscription.trial') }}</span>
	</p>
	<p class="subscription__action">
		{% if plan.max == 999999999999999 %}
			<a class="button button--{{ plan.planName }}" href="mailto:sandoche@revenual.com?subject=Revenual%20-%20Enterprise%20subscription&body=Hi%2C%0D%0A%0D%0AI%20would%20like%20to%20try%20Revenual%20Enterprise%2C%0D%0ACan%20you%20please%20activate%20the%20free%20trial%3F%0D%0A%0D%0ABest%20regards%2C">
				{{ __('subscription.subscribe') }}
			</a>
		{% else %}
			<a class="button button--{{ plan.planName }}" href="/subscription/{{ plan.planName }}/{{ plan.currencyText }}">
				{{ __('subscription.subscribe') }}
			</a>
		{% endif %}
	</p>
</div>
